{
  "name": "@wanxxz/dsh-wechat",
  "version": "0.1.0",
  "private": true,
  "description": "WeChat channel for DeepSeek Harness: QR login over the WeChat iLink Bot (微信 ClawBot) API, message <-> Session bridging, and an agent tool for proactive sends",
  "author": "Yiwan Zhou <mail@yiwan.me>",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "vendor/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
